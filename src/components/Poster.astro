---
---
<div class="poster">
  <svg viewBox="0 0 400 520" role="img" aria-label="Poster: an illustrated keypad phone with the words Back to S60">
    <defs>
      <pattern id="dots" width="8" height="8" patternUnits="userSpaceOnUse" patternTransform="rotate(30)">
        <circle cx="2" cy="2" r="1.5" fill="#000" opacity=".22" />
      </pattern>
      <pattern id="grain" width="4" height="4" patternUnits="userSpaceOnUse">
        <rect width="1" height="1" x="1" y="2" fill="#000" opacity=".18" />
        <rect width="1" height="1" x="3" y="0" fill="#fff" opacity=".25" />
      </pattern>
      <linearGradient id="scr" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#bcd6f2" /><stop offset="1" stop-color="#78A2D6" />
      </linearGradient>
    </defs>
    <rect width="400" height="520" fill="#E5D3AE" />
    <rect width="400" height="520" fill="url(#dots)" />
    <circle cx="300" cy="150" r="118" fill="#D65A5A" />
    <circle cx="300" cy="150" r="118" fill="url(#dots)" />
    <!-- title -->
    <text x="22" y="62" font-family="'Barlow Condensed','Arial Narrow',sans-serif" font-weight="700" font-size="62" fill="#111" letter-spacing="1">BACK TO</text>
    <rect x="18" y="72" width="168" height="62" fill="#111" />
    <rect x="12" y="66" width="168" height="62" fill="#78A2D6" />
    <text x="24" y="118" font-family="'Barlow Condensed','Arial Narrow',sans-serif" font-weight="700" font-size="62" fill="#111" letter-spacing="2">S60</text>
    <!-- phone shadow -->
    <g transform="translate(40 176) scale(.88) rotate(-6 100 150)">
      <rect x="14" y="14" width="190" height="300" fill="#111" />
      <!-- top slide -->
      <rect x="0" y="0" width="190" height="168" fill="#3b3f46" stroke="#111" stroke-width="3" />
      <rect x="0" y="0" width="190" height="168" fill="url(#grain)" />
      <rect x="10" y="12" width="170" height="10" fill="#1d2025" />
      <rect x="70" y="15" width="50" height="4" fill="#555a63" />
      <rect x="18" y="30" width="154" height="108" fill="#111" />
      <rect x="23" y="35" width="144" height="98" fill="url(#scr)" />
      <!-- screen UI -->
      <rect x="23" y="35" width="144" height="12" fill="#2d4f7c" />
      <rect x="30" y="38" width="30" height="6" fill="#bcd6f2" />
      <g fill="#fff" opacity=".92">
        <rect x="32" y="56" width="22" height="22" /><rect x="84" y="56" width="22" height="22" /><rect x="136" y="56" width="22" height="22" />
        <rect x="32" y="90" width="22" height="22" /><rect x="84" y="90" width="22" height="22" />
      </g>
      <rect x="136" y="90" width="22" height="22" fill="#D65A5A" />
      <rect x="23" y="121" width="144" height="12" fill="#2d4f7c" />
      <!-- d-pad row -->
      <rect x="18" y="146" width="40" height="12" fill="#1d2025" />
      <rect x="132" y="146" width="40" height="12" fill="#1d2025" />
      <circle cx="95" cy="152" r="9" fill="#9aa1ac" stroke="#111" stroke-width="2" />
      <!-- bottom slide -->
      <rect x="0" y="150" width="190" height="150" fill="#2a2d33" stroke="#111" stroke-width="3" transform="translate(0 18)" />
      <rect x="0" y="168" width="190" height="150" fill="url(#grain)" />
      <rect x="0" y="168" width="190" height="6" fill="#111" opacity=".5" />
      <g fill="#c9ccd1" stroke="#111" stroke-width="2">
        <rect x="16" y="186" width="48" height="26" /><rect x="71" y="186" width="48" height="26" /><rect x="126" y="186" width="48" height="26" />
        <rect x="16" y="220" width="48" height="26" /><rect x="71" y="220" width="48" height="26" /><rect x="126" y="220" width="48" height="26" />
        <rect x="16" y="254" width="48" height="26" /><rect x="71" y="254" width="48" height="26" /><rect x="126" y="254" width="48" height="26" />
      </g>
      <g fill="#111" font-family="'Barlow Condensed',Arial,sans-serif" font-weight="700" font-size="16" text-anchor="middle">
        <text x="40" y="205">1</text><text x="95" y="205">2</text><text x="150" y="205">3</text>
        <text x="40" y="239">4</text><text x="95" y="239">5</text><text x="150" y="239">6</text>
        <text x="40" y="273">7</text><text x="95" y="273">8</text><text x="150" y="273">9</text>
      </g>
    </g>
    <!-- chevrons -->
    <g fill="none" stroke="#111" stroke-width="9" stroke-linecap="square">
      <path d="M300 330 l22 22 l-22 22" /><path d="M326 330 l22 22 l-22 22" opacity=".6" /><path d="M352 330 l22 22 l-22 22" opacity=".3" />
    </g>
    <rect x="262" y="400" width="118" height="8" fill="#111" />
    <text x="262" y="436" font-family="'Barlow Condensed','Arial Narrow',sans-serif" font-weight="600" font-size="22" fill="#111" letter-spacing="3">SYMBIAN 9.3</text>
    <text x="262" y="462" font-family="'Barlow Condensed','Arial Narrow',sans-serif" font-weight="600" font-size="22" fill="#111" letter-spacing="3">240 × 320</text>
    <text x="22" y="502" font-family="'Barlow Condensed','Arial Narrow',sans-serif" font-weight="600" font-size="18" fill="#111" letter-spacing="4">PRESS ANY KEY</text>
  </svg>
</div>
