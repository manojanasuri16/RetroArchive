---
import Base from '../../layouts/Base.astro';
import Detail from '../../components/Detail.astro';
import { getSdks } from '../../lib/catalog';
export async function getStaticPaths() {
  return (await getSdks()).map((item) => ({ params: { slug: item.slug }, props: { item } }));
}
const { item } = Astro.props;
---
<Base title={item.data.name} nav="sdks" description={item.data.tagline}>
  <Detail item={item} />
</Base>
